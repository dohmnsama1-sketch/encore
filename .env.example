# Qloo hackathon API key (server-side only, never committed). Get one via the Qloo hackathon Devpost page.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Requests per second to Qloo (the hackathon key allows 10/s; default 7 leaves headroom)
QLOO_RPS=7

# Optional LLM for the planner + copywriter. Without it Marquee uses its deterministic rules planner.
# Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Gemini OpenAI-compat, Ollama...):
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Or the Vercel AI Gateway (on Vercel, the deployment's OIDC token is used automatically):
AI_GATEWAY_API_KEY=

PORT=8787
